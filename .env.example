# Application
APP_ENV=development
APP_NAME=tillegal-ai
LOG_LEVEL=INFO
DEBUG=false

# API
HOST=0.0.0.0
PORT=8000
API_TIMEOUT_SECONDS=120
API_MAX_BODY_SIZE_MB=25

# Model gateway / providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LITELLM_API_BASE=
LITELLM_API_KEY=
ANTHROPIC_API_KEY=

# Supabase / RAG
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=
SUPABASE_AUTO_MIGRATE=false

# Workflow runtime
LANGGRAPH_CHECKPOINTER_ENABLED=false
WORKFLOW_TIMEOUT_SECONDS=120
MAX_RETRY_COUNT=3

# Standalone local module factory (see docs/transferred-rag.md)
TILLEGAL_E5_PATH=
TILLEGAL_E5_REVISION=
GEMINI_MODEL=
GEMINI_API_KEY=
