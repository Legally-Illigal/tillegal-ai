# Application
APP_ENV=development
APP_NAME=tillegal-ai
LOG_LEVEL=INFO
DEBUG=false

# API
HOST=0.0.0.0
PORT=8000
API_TIMEOUT_SECONDS=120
API_MAX_BODY_SIZE_MB=25

# Model gateway / providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LITELLM_API_BASE=
LITELLM_API_KEY=
ANTHROPIC_API_KEY=

# Supabase / RAG
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=
SUPABASE_AUTO_MIGRATE=false

# VBPL ingestion
VBPL_MAX_SITEMAP_SIZE_MB=10
VBPL_MAX_SITEMAP_COUNT=100
VBPL_SITEMAP_TIMEOUT_SECONDS=45
VBPL_REQUEST_PAUSE_SECONDS=0.25
VBPL_MAX_PAGE_SIZE_MB=5
VBPL_MAX_BUNDLE_SIZE_MB=5
VBPL_MAX_ATTACHMENT_SIZE_MB=100
VBPL_PAGE_TIMEOUT_SECONDS=45
VBPL_ATTACHMENT_TIMEOUT_SECONDS=90
VBPL_DOC_CONVERSION_TIMEOUT_SECONDS=60
VBPL_WORKER_POLL_INTERVAL_SECONDS=5
VBPL_WORKER_LEASE_SECONDS=180
VBPL_WORKER_HEARTBEAT_INTERVAL_SECONDS=45
VBPL_CHUNK_MAX_TOKENS=480
VBPL_EMBEDDING_BATCH_SIZE=32

# Workflow runtime
LANGGRAPH_CHECKPOINTER_ENABLED=false
WORKFLOW_TIMEOUT_SECONDS=120
MAX_RETRY_COUNT=3
