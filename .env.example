# Application
APP_ENV=development
APP_NAME=tillegal-ai
LOG_LEVEL=INFO
DEBUG=false

# API
HOST=0.0.0.0
PORT=8000
API_TIMEOUT_SECONDS=120
API_MAX_BODY_SIZE_MB=25

# Model gateway / providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LITELLM_API_BASE=
LITELLM_API_KEY=
ANTHROPIC_API_KEY=

# Supabase / RAG
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=
SUPABASE_AUTO_MIGRATE=false

# Workflow runtime
LANGGRAPH_CHECKPOINTER_ENABLED=false
WORKFLOW_TIMEOUT_SECONDS=120
MAX_RETRY_COUNT=3

# Local legal QA pilot (opt-in; production defaults remain unchanged)
TILLEGAL_RAG_PILOT=0
TILLEGAL_ANSWER_PROVIDER=mock
TILLEGAL_ANSWER_MODEL=qwen-pilot
TILLEGAL_LOCAL_PORT=18963
TILLEGAL_RETRIEVAL_MODE=bm25
TILLEGAL_RERANK=false
TILLEGAL_CONTEXT_POLICY=legacy
# Set TILLEGAL_INDEX to a compatible manifest.json when using a custom index.
# POST /pilot/legal-qa with workflow="semantic" for generation + verification.
